<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Win32, registry, WMI and file adapters of the Core ports. Core stays free of them -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- CsWin32's generated marshalling needs unsafe -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.346">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClinicAVT.App.Core\ClinicAVT.App.Core.csproj" />
  </ItemGroup>

</Project>
