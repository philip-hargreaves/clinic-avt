<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Shell.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls">

    <Border
        Padding="24,6"
        Background="{ThemeResource StatusBarBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <Grid x:Name="Bar" ColumnSpacing="16" SizeChanged="OnBarSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:BusyCaption
                x:Name="State"
                IsActive="{x:Bind ViewModel.Busy, Mode=OneWay}"
                Text="{x:Bind ViewModel.DisplayLabel, Mode=OneWay}"
                TextStyle="{StaticResource CaptionText}" />

            <TextBlock
                Grid.Column="1"
                Style="{StaticResource MicroText}"
                Text="Ensure patient consent is given before recording"
                TextWrapping="NoWrap"
                Visibility="{x:Bind ViewModel.ConsentVisible, Mode=OneWay}" />

            <!-- Setup can take minutes, so an indeterminate bar shows beside the elapsed time -->
            <ProgressBar
                Grid.Column="1"
                Width="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.ShowsSetup, Mode=OneWay}" />

            <!-- A hidden child leaves no gap, so the chips sit flush right without marks -->
            <StackPanel
                x:Name="ChipsAndMarks"
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="24"
                VerticalAlignment="Center">
                <!-- Tabular figures keep changing digits from jittering -->
                <StackPanel
                    x:Name="Chips"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Style="{StaticResource ChipBorder}"
                        Visibility="{x:Bind ViewModel.Chips.AsrChipVisible, Mode=OneWay}">
                        <!-- Colour pairs swap by visibility because a brush set in code would not
                             follow a live theme change -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.Chips.AsrActive, Mode=OneWay}" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                Visibility="{x:Bind ViewModel.Chips.AsrResting, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CaptionText}"
                                Text="{x:Bind ViewModel.Chips.AsrChip, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Style="{StaticResource ChipBorder}"
                        Visibility="{x:Bind ViewModel.Chips.NoteChipVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.Chips.NoteActive, Mode=OneWay}" />
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                Visibility="{x:Bind ViewModel.Chips.NoteResting, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CaptionText}"
                                Text="{x:Bind ViewModel.Chips.NoteChip, Mode=OneWay}"
                                Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                    <!-- Memory is a footprint with no activity, so it has no dot -->
                    <Border
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Style="{StaticResource ChipBorder}"
                        Visibility="{x:Bind ViewModel.Chips.MemoryChipVisible, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource CaptionText}"
                            Text="{x:Bind ViewModel.Chips.MemoryChip, Mode=OneWay}"
                            Typography.NumeralAlignment="Tabular" />
                    </Border>
                </StackPanel>

                <!-- The partner marks come from Assets/logos/credits.json -->
                <StackPanel
                    x:Name="CreditsRow"
                    Orientation="Horizontal"
                    Spacing="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
