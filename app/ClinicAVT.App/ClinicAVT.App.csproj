<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Dev and stakeholder runs are unpackaged. MSIX returns with the
         distribution work. Self-contained, so no runtime install is needed -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- English-only satellite resources, otherwise ~90 culture folders -->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClinicAVT.Client\ClinicAVT.Client.csproj" />
    <ProjectReference Include="..\ClinicAVT.App.Core\ClinicAVT.App.Core.csproj" />
    <ProjectReference Include="..\ClinicAVT.App.Platform\ClinicAVT.App.Platform.csproj" />
  </ItemGroup>

  <!-- Ship the engine beside the app when it has been built. F5 works without it.
       Hidden from Solution Explorer: they are payload, not source.
       Always the Release engine: a Debug engine is 5-10x slower through the
       models and makes every timing observation misleading -->
  <PropertyGroup>
    <EnginePreset>release</EnginePreset>
    <EngineBinary>..\..\build\$(EnginePreset)\engine\clinicavt_engine.exe</EngineBinary>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(EngineBinary)')">
    <Content Include="$(EngineBinary)" Link="clinicavt_engine.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- The PDF reader. Without it added PDFs are skipped -->
    <Content Include="..\..\build\$(EnginePreset)\engine\clinicavt_ingest_host.exe" Link="clinicavt_ingest_host.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\build\$(EnginePreset)\engine\clinicavt_ingest_host.exe')" />
    <Content Include="..\..\engine\licences\pdfium\*.txt" Link="licences\pdfium\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\engine\licences\THIRD-PARTY-NOTICES.txt" Link="licences\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- The note worker. Without it the engine writes notes in-process -->
    <Content Include="..\..\build\$(EnginePreset)\engine\clinicavt_note_host.exe" Link="clinicavt_note_host.exe" CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\build\$(EnginePreset)\engine\clinicavt_note_host.exe')" />
    <!-- The engine's OpenVINO runtime, deployed beside it by the CMake build -->
    <Content Include="..\..\build\$(EnginePreset)\engine\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\..\build\$(EnginePreset)\engine\cache.json" Link="cache.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Dev runs see the repo model store via a junction. Packaging replaces this -->
  <Target Name="LinkModelStore" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\models') And !Exists('$(TargetDir)models')">
    <Exec Command="mklink /J &quot;$(TargetDir)models&quot; &quot;$(MSBuildProjectDirectory)\..\..\models&quot;" />
  </Target>

  <!-- Packaged F5 runs the engine from AppX, which needs the same link -->
  <Target Name="LinkModelStoreAppX" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\models') And Exists('$(TargetDir)AppX') And !Exists('$(TargetDir)AppX\models')">
    <Exec Command="mklink /J &quot;$(TargetDir)AppX\models&quot; &quot;$(MSBuildProjectDirectory)\..\..\models&quot;" />
  </Target>

  <!-- Prompts ride the same junction, so a repo edit applies to the next note -->
  <Target Name="LinkPrompts" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\prompts') And !Exists('$(TargetDir)prompts')">
    <Exec Command="mklink /J &quot;$(TargetDir)prompts&quot; &quot;$(MSBuildProjectDirectory)\..\..\prompts&quot;" />
  </Target>
  <Target Name="LinkPromptsAppX" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\prompts') And Exists('$(TargetDir)AppX') And !Exists('$(TargetDir)AppX\prompts')">
    <Exec Command="mklink /J &quot;$(TargetDir)AppX\prompts&quot; &quot;$(MSBuildProjectDirectory)\..\..\prompts&quot;" />
  </Target>

  <!-- Demo tracks too, so every layout has demo\ beside the exe -->
  <Target Name="LinkDemo" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\demo') And !Exists('$(TargetDir)demo')">
    <Exec Command="mklink /J &quot;$(TargetDir)demo&quot; &quot;$(MSBuildProjectDirectory)\..\..\demo&quot;" />
  </Target>
  <Target Name="LinkDemoAppX" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\demo') And Exists('$(TargetDir)AppX') And !Exists('$(TargetDir)AppX\demo')">
    <Exec Command="mklink /J &quot;$(TargetDir)AppX\demo&quot; &quot;$(MSBuildProjectDirectory)\..\..\demo&quot;" />
  </Target>

  <!-- Built corpora, corpora\ beside the exe -->
  <Target Name="LinkCorpora" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\rag\corpora') And !Exists('$(TargetDir)corpora')">
    <Exec Command="mklink /J &quot;$(TargetDir)corpora&quot; &quot;$(MSBuildProjectDirectory)\..\..\rag\corpora&quot;" />
  </Target>
  <Target Name="LinkCorporaAppX" AfterTargets="Build" Condition="Exists('$(MSBuildProjectDirectory)\..\..\rag\corpora') And Exists('$(TargetDir)AppX') And !Exists('$(TargetDir)AppX\corpora')">
    <Exec Command="mklink /J &quot;$(TargetDir)AppX\corpora&quot; &quot;$(MSBuildProjectDirectory)\..\..\rag\corpora&quot;" />
  </Target>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <!-- Read back at runtime by AppWindow.SetIcon, so it must ship -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <!-- Partner marks. The json decides what shows, per showcase -->
    <Content Include="Assets\logos\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Trimming breaks XAML reflection too easily. Revisit if package size matters -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>