<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Sessions.SessionsView"
    x:Name="SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    xmlns:vm="using:ClinicAVT.App.Core.Features.Sessions">

    <UserControl.Resources>
        <CollectionViewSource
            x:Name="Grouped"
            IsSourceGrouped="True"
            Source="{x:Bind ViewModel.Groups}" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Sessions">
            <controls:PageHeader.Commands>
                <Button AutomationProperties.Name="Back up consultations" Command="{x:Bind ViewModel.BackUpCommand}">
                    <controls:IconLabel Glyph="&#xE8F7;" Text="Back up&#x2026;" />
                </Button>
            </controls:PageHeader.Commands>
        </controls:PageHeader>

        <Grid Grid.Row="1" Padding="24,0,24,16" ColumnSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- One hairline between the inbox and the review, centred in the gap -->
            <Border
                Grid.RowSpan="2"
                Width="1"
                Margin="0,0,-12,0"
                HorizontalAlignment="Right"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBox
                Margin="0,0,0,8"
                AutomationProperties.Name="Search consultations"
                PlaceholderText="Search consultations"
                Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind Grouped.View, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="vm:SessionGroup">
                                <TextBlock
                                    Margin="0,8,0,4"
                                    Style="{StaticResource CaptionText}"
                                    Text="{x:Bind Day}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionRow">
                        <!-- An unlabelled row is one line. A labelled row adds its date and length -->
                        <StackPanel Padding="0,8" Spacing="2">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <!-- ElementName because x:Bind in a template sees only the row -->
                                    <MenuFlyoutItem
                                        Command="{Binding ElementName=SessionsPage, Path=ViewModel.DeleteCommand}"
                                        CommandParameter="{x:Bind}"
                                        Text="Delete">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <TextBlock Text="{x:Bind Heading}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind MetaVisible}">
                                <TextBlock
                                    Style="{StaticResource CaptionText}"
                                    Text="{x:Bind Meta}"
                                    Visibility="{x:Bind HasLabel}" />
                                <TextBlock
                                    Style="{StaticResource MicroText}"
                                    Text="{x:Bind EditedLabel}"
                                    Visibility="{x:Bind Edited}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid
                Grid.Row="1"
                Grid.Column="1"
                RowSpacing="20"
                Visibility="{x:Bind ViewModel.DetailOpen, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Same MaxWidth as the review, so the header lines up with the documents -->
                <Grid
                    MaxWidth="1480"
                    HorizontalAlignment="Stretch"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="0">
                        <TextBox
                            AutomationProperties.Name="Consultation label"
                            LostFocus="OnTitleCommitted"
                            Style="{StaticResource TitleTextBox}"
                            PlaceholderText="Name this consultation"
                            Text="{x:Bind ViewModel.DetailTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionText}"
                                Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource MicroText}"
                                Text="{x:Bind ViewModel.Note.EditedStamp, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Note.Edited, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.DeleteCommand}"
                        CommandParameter="{x:Bind ViewModel.Selected, Mode=OneWay}">
                        <controls:IconLabel Glyph="&#xE74D;" Text="Delete consultation" />
                    </Button>
                </Grid>

                <ContentControl
                    x:Name="SurfaceHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>

            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.SelectHintVisible, Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource PaneHeaderText}"
                    Text="No consultations yet"
                    Visibility="{x:Bind ViewModel.NothingStored, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="Each one you record is kept here, with its transcript, note and patient information."
                    Visibility="{x:Bind ViewModel.NothingStored, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource PaneHeaderText}"
                    Text="Select a consultation"
                    Visibility="{x:Bind ViewModel.NoneOpen, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Row="1"
                Grid.ColumnSpan="2"
                MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind ViewModel.EmptyBecauseOff, Mode=OneWay}">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="24"
                    Foreground="{ThemeResource FaintTextBrush}"
                    Glyph="&#xE72E;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource PaneHeaderText}"
                    Text="Consultations are not being kept" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Text="Consultations aren't saved on this device. Turn on Save consultation data in Settings to keep them." />
                <Button
                    AutomationProperties.Name="Open Settings"
                    HorizontalAlignment="Center"
                    Command="{x:Bind Shell.ShowSettingsCommand}">
                    <controls:IconLabel Glyph="&#xE713;" Text="Open Settings" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
