<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Consultation.ConsultationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls">

    <!-- A recording dragged anywhere on the page can be imported, so all of it takes hits -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Consultation">
            <controls:PageHeader.Commands>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- The microphone is set once, so it sits with the page commands -->
                    <DropDownButton
                        AutomationProperties.Name="{x:Bind Mic.Label, Mode=OneWay}"
                        Style="{StaticResource TrayButton}"
                        ToolTipService.ToolTip="{x:Bind Controls.MicTip, Mode=OneWay}"
                        Visibility="{x:Bind Controls.MicPickerVisible, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE720;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource MutedTextBrush}"
                                Text="{x:Bind Mic.Label, Mode=OneWay}" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout
                                x:Name="MicFlyout"
                                Opening="OnMicFlyoutOpening"
                                Placement="BottomEdgeAlignedRight" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        Command="{x:Bind Controls.FinishConsultationCommand}"
                        Content="Finish consultation"
                        Visibility="{x:Bind Controls.ReviewVisible, Mode=OneWay}" />
                </StackPanel>
            </controls:PageHeader.Commands>
        </controls:PageHeader>

        <!-- Record control until stop, then the documents -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <!-- The 2* and 3* rows put the record control at the optical centre, two fifths down. The
                 footnote hangs below it without moving it -->
            <Grid Visibility="{x:Bind Controls.CentreStageVisible, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>
                <ContentControl
                    x:Name="ControlsHost"
                    Grid.Row="1"
                    MaxWidth="560"
                    HorizontalAlignment="Center" />
                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind Controls.IdleVisible, Mode=OneWay}">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource MutedTextBrush}"
                        Style="{StaticResource BodyText}"
                        Text="Already have a recording?" />
                    <HyperlinkButton
                        Padding="0"
                        VerticalAlignment="Center"
                        Command="{x:Bind Controls.ImportRecordingCommand}"
                        Content="Import the file" />
                </StackPanel>
            </Grid>
            <!-- The top margin is the height of the Sessions search row, so the title lines up
                 with the inbox title -->
            <Grid
                Margin="0,44,0,0"
                RowSpacing="20"
                Visibility="{x:Bind Controls.PanesVisible, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="16" />
                    </TransitionCollection>
                </Grid.ChildrenTransitions>
                <!-- Matches the inbox title's size and weight -->
                <TextBlock
                    MaxWidth="1480"
                    Padding="0,4"
                    HorizontalAlignment="Stretch"
                    FontSize="{StaticResource SubtitleTextBlockFontSize}"
                    FontWeight="SemiBold"
                    Text="{x:Bind Header.Title, Mode=OneWay}" />
                <ContentControl
                    x:Name="SurfaceHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>

            <Grid
                x:Name="DropHighlight"
                IsHitTestVisible="False"
                Opacity="0">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Grid.OpacityTransition>
                <Rectangle
                    Fill="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    RadiusX="8"
                    RadiusY="8"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeDashArray="4,3"
                    StrokeThickness="1.5" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8B5;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Drop to import" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
