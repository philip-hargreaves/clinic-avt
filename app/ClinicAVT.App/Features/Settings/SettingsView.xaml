<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Settings.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ClinicAVT.App.Core.Features.Settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Title="Settings" />
        <ScrollViewer Grid.Row="1">
            <Grid Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Takes the width up to the cap and the gutters share the rest -->
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadingColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Spacing="4">

                <TextBlock
                    Margin="4,4,0,4"
                    Style="{StaticResource SettingsGroupHeader}"
                    Text="Appearance" />
                <toolkit:SettingsCard Description="System default follows Windows" Header="Theme">
                    <ComboBox
                        MinWidth="160"
                        ItemsSource="{x:Bind ViewModel.Appearance.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.Appearance.ThemeIndex, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Your data" />
                <toolkit:SettingsCard Description="Encrypted on this device, the audio is never kept" Header="Save consultation data">
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="Save consultation data"
                        IsOn="{x:Bind ViewModel.Privacy.KeepConsultations, Mode=TwoWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Header="Voice enrolment">
                    <toolkit:SettingsCard.Description>
                        <!-- Forget is rare and cannot be undone, so it is a small link -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Voice.Headline, Mode=OneWay}" />
                            <HyperlinkButton
                                Padding="0"
                                VerticalAlignment="Center"
                                Command="{x:Bind Voice.ForgetVoiceCommand}"
                                Content="Forget"
                                Style="{StaticResource CaptionLink}"
                                Visibility="{x:Bind Voice.HasVoice, Mode=OneWay}" />
                        </StackPanel>
                    </toolkit:SettingsCard.Description>
                    <Button
                        MinWidth="160"
                        Command="{x:Bind Voice.SetUpVoiceCommand}"
                        Content="{x:Bind Voice.SetUpLabel, Mode=OneWay}" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="{x:Bind ViewModel.Privacy.BackupDescription, Mode=OneWay}" Header="Back up consultations">
                    <Button
                        MinWidth="160"
                        Command="{x:Bind ViewModel.Privacy.BackUpCommand}"
                        Content="Back up&#x2026;" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Bring consultations back from a backup file." Header="Restore from a backup">
                    <Button
                        MinWidth="160"
                        Command="{x:Bind ViewModel.Privacy.RestoreCommand}"
                        Content="Restore&#x2026;" />
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Every stored consultation, with its notes. Cannot be undone." Header="Delete all consultation data">
                    <Button
                        MinWidth="160"
                        Command="{x:Bind ViewModel.Privacy.DeleteAllConsultationsCommand}"
                        Content="Delete all"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Performance" />
                <toolkit:SettingsCard Description="{x:Bind ViewModel.NoteModel.NoteModelCaption, Mode=OneWay}" Header="Note model">
                    <StackPanel Spacing="8">
                        <ComboBox
                            MinWidth="160"
                            AutomationProperties.Name="Note model"
                            IsEnabled="{x:Bind ViewModel.NoteModel.PickerEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.NoteModel.NoteModelOptions}"
                            SelectedIndex="{x:Bind ViewModel.NoteModel.NoteModelIndex, Mode=TwoWay}" />
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.NoteModel.ModelLoading, Mode=OneWay}" />
                    </StackPanel>
                </toolkit:SettingsCard>
                <toolkit:SettingsCard Description="Runs speech recognition on the NPU to save battery. Transcripts may take a little longer." Header="Low-power mode">
                    <ToggleSwitch
                        MinWidth="0"
                        AutomationProperties.Name="Low-power mode"
                        IsOn="{x:Bind ViewModel.Appearance.NpuTranscription, Mode=TwoWay}" />
                </toolkit:SettingsCard>

                <TextBlock Style="{StaticResource SettingsGroupHeader}" Text="Guideline documents" />
                <!-- Guidance installed with the app, if any -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Guidance.GuidanceInstalledVisible, Mode=OneWay}">
                    <toolkit:SettingsCard
                        Description="{x:Bind ViewModel.Guidance.GuidanceCaption, Mode=OneWay}"
                        Header="Installed guidance"
                        Visibility="{x:Bind ViewModel.Guidance.GuidanceCaptionVisible, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Guidance.GuidanceCorpora}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CorpusRow">
                                <toolkit:SettingsCard Margin="0,0,0,4" Header="{x:Bind Name}">
                                    <toolkit:SettingsCard.Description>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind Loaded}" />
                                            <TextBlock
                                                Foreground="{ThemeResource CautionBrush}"
                                                Text="{x:Bind Detail}"
                                                Visibility="{x:Bind Refused}" />
                                            <!-- The licence requires this line, so it wraps in full -->
                                            <TextBlock
                                                Text="{x:Bind Attribution}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind AttributionVisible}" />
                                        </StackPanel>
                                    </toolkit:SettingsCard.Description>
                                </toolkit:SettingsCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- The view model opens the list once when a document fails -->
                <toolkit:SettingsExpander
                    Header="Your guideline documents"
                    IsExpanded="{x:Bind ViewModel.Guidance.DocumentsExpanded, Mode=TwoWay}"
                    ItemsSource="{x:Bind ViewModel.Guidance.Documents}">
                    <toolkit:SettingsExpander.Description>
                        <StackPanel Spacing="2">
                            <TextBlock
                                Text="{x:Bind ViewModel.Guidance.DocumentsSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Guidance.DocumentsPresent, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Guidance.DocumentsCaption, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.Guidance.DocumentsCaptionVisible, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource CautionBrush}"
                                Text="The folder could not be reached. Nothing has been removed."
                                Visibility="{x:Bind ViewModel.Guidance.FolderMissing, Mode=OneWay}" />
                            <TextBlock
                                Text="This folder is inside OneDrive, so these documents sync to the cloud."
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.Guidance.FolderInOneDrive, Mode=OneWay}" />
                        </StackPanel>
                    </toolkit:SettingsExpander.Description>
                    <Button
                        MinWidth="160"
                        Command="{x:Bind ViewModel.Guidance.AddDocumentsCommand}"
                        Content="Add documents"
                        Style="{StaticResource AccentButtonStyle}" />
                    <toolkit:SettingsExpander.ItemsHeader>
                        <toolkit:SettingsCard ContentAlignment="Left" Description="PDF, text and Markdown files here are searched after each note for medical guidance. Do not add patient-identifiable documents.">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <HyperlinkButton
                                    Padding="0"
                                    Command="{x:Bind ViewModel.Guidance.OpenFolderCommand}"
                                    Content="Open folder"
                                    Style="{StaticResource CaptionLink}" />
                                <HyperlinkButton
                                    Padding="0"
                                    Command="{x:Bind ViewModel.Guidance.RemoveAllDocumentsCommand}"
                                    Content="Remove all"
                                    Style="{StaticResource CaptionLink}"
                                    Visibility="{x:Bind ViewModel.Guidance.DocumentsPresent, Mode=OneWay}" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.ItemsHeader>
                    <toolkit:SettingsExpander.ItemTemplate>
                        <DataTemplate x:DataType="vm:DocumentRow">
                            <toolkit:SettingsCard Header="{x:Bind Name}">
                                <toolkit:SettingsCard.Description>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Where}" Visibility="{x:Bind Located}" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind Plain, Mode=OneWay}" />
                                        <TextBlock
                                            Foreground="{ThemeResource CautionBrush}"
                                            Text="{x:Bind Detail, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind Failed, Mode=OneWay}" />
                                        <ProgressBar
                                            Height="3"
                                            Margin="0,4,0,0"
                                            IsIndeterminate="{x:Bind Waiting, Mode=OneWay}"
                                            Maximum="1"
                                            Value="{x:Bind Progress, Mode=OneWay}"
                                            Visibility="{x:Bind Working, Mode=OneWay}" />
                                    </StackPanel>
                                </toolkit:SettingsCard.Description>
                                <Button
                                    AutomationProperties.Name="Remove"
                                    Command="{x:Bind Remove}"
                                    CommandParameter="{x:Bind}"
                                    Style="{StaticResource TrayButton}"
                                    ToolTipService.ToolTip="Remove this document">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                            </toolkit:SettingsCard>
                        </DataTemplate>
                    </toolkit:SettingsExpander.ItemTemplate>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander
                    Margin="0,16,0,0"
                    Description="Seed data and performance figures, for testing and demos"
                    Header="Developer tools"
                    IsExpanded="{x:Bind ViewModel.Appearance.DeveloperToolsExpanded, Mode=TwoWay}">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard Description="A year of consultations and reflections from PriMock57 recordings" Header="Seed data">
                            <ToggleSwitch
                                MinWidth="0"
                                AutomationProperties.Name="Seed data"
                                IsOn="{x:Bind ViewModel.Privacy.SeedDataEnabled, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                            Description="Search the local research corpus, the NICE demo. Never ships"
                            Header="Include research guidance"
                            Visibility="{x:Bind ViewModel.Guidance.ResearchToggleVisible}">
                            <ToggleSwitch
                                MinWidth="0"
                                AutomationProperties.Name="Include research guidance"
                                IsOn="{x:Bind ViewModel.Guidance.IncludeResearchGuidance, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Model and speed figures in the status bar" Header="Performance metrics">
                            <ToggleSwitch
                                MinWidth="0"
                                AutomationProperties.Name="Performance metrics"
                                IsOn="{x:Bind ViewModel.Appearance.ShowPerformanceMetrics, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="Timings to a local file, the audio and text are never included" Header="Collect performance data">
                            <ToggleSwitch
                                MinWidth="0"
                                AutomationProperties.Name="Collect performance data"
                                IsOn="{x:Bind ViewModel.Appearance.CollectPerformanceData, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Description="{x:Bind ViewModel.Appearance.ExportDescription, Mode=OneWay}" Header="Export performance report">
                            <Button
                                MinWidth="160"
                                Command="{x:Bind ViewModel.Appearance.ExportPerformanceReportCommand}"
                                Content="Export" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
