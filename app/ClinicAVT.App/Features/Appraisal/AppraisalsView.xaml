<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Appraisal.AppraisalsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    xmlns:local="using:ClinicAVT.App.Features.Appraisal"
    xmlns:vm="using:ClinicAVT.App.Core.Features.Appraisal">

    <UserControl.Resources>
        <!-- A disabled stepper end fades without a fill -->
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="Appraisal">
            <controls:PageHeader.Commands>
                <Button AutomationProperties.Name="Export reflections" Command="{x:Bind ViewModel.ExportReflectionsCommand}">
                    <controls:IconLabel Glyph="&#xEDE1;" Text="Export reflections&#x2026;" />
                </Button>
            </controls:PageHeader.Commands>
        </controls:PageHeader>

        <ScrollViewer Grid.Row="1">
            <Grid Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Takes the width up to the cap and the gutters share the rest -->
                    <ColumnDefinition Width="1000*" MaxWidth="{StaticResource ReadingColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            <Grid
                Grid.Column="1"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button
                            AutomationProperties.Name="Earlier"
                            Command="{x:Bind ViewModel.PreviousYearCommand}"
                            Style="{StaticResource TrayButton}"
                            ToolTipService.ToolTip="Earlier">
                            <FontIcon FontSize="{StaticResource CaptionTextBlockFontSize}" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="{x:Bind ViewModel.YearLabel, Mode=OneWay}"
                            MinWidth="52"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ShowWholeYearCommand}"
                            Style="{StaticResource TrayButton}"
                            ToolTipService.ToolTip="Show the whole year">
                            <TextBlock
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                TextAlignment="Center"
                                Text="{x:Bind ViewModel.YearLabel, Mode=OneWay}" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Later"
                            Command="{x:Bind ViewModel.NextYearCommand}"
                            Style="{StaticResource TrayButton}"
                            ToolTipService.ToolTip="Later">
                            <FontIcon FontSize="{StaticResource CaptionTextBlockFontSize}" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource FaintTextBrush}"
                        Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" />
                    <TextBox
                        Grid.Column="2"
                        Width="240"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search reflections"
                        PlaceholderText="Search reflections"
                        Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- The month items are built in code -->
                <SelectorBar
                    x:Name="MonthBar"
                    Grid.Row="1"
                    SelectionChanged="OnMonthChanged" />

                <Grid Grid.Row="2">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReflectionCard">
                                <local:ReflectionCardView Card="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel
                        Margin="0,56,0,0"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.Empty, Mode=OneWay}">
                        <TextBlock
                            Style="{StaticResource PaneHeaderText}"
                            TextAlignment="Center"
                            Text="Nothing here yet" />
                        <TextBlock
                            MaxWidth="440"
                            Foreground="{ThemeResource MutedTextBrush}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Text="After a consultation, press Create reflection on the clinical note to write what stood out, what you learned and whether you would do anything differently. Your reflections gather here by month, ready for your appraisal." />
                    </StackPanel>
                </Grid>
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
