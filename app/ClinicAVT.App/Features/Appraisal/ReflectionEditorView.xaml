<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Appraisal.ReflectionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appraisal="using:ClinicAVT.App.Core.Features.Appraisal"
    xmlns:controls="using:ClinicAVT.App.Controls">

    <StackPanel Spacing="16">

        <!-- A journal card shows the title in its own header and hides this one -->
        <StackPanel Spacing="4" Visibility="{x:Bind ShowHeading}">
            <TextBox
                AutomationProperties.Name="Reflection title"
                LostFocus="OnTitleCommitted"
                Style="{StaticResource TitleTextBox}"
                PlaceholderText="{x:Bind ViewModel.Month, Mode=OneWay}"
                Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Style="{StaticResource CaptionText}" Text="{x:Bind ViewModel.Month, Mode=OneWay}" />
        </StackPanel>

        <Border Style="{StaticResource InnerCardSurface}" Padding="16,12">
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Style="{StaticResource MicroText}" VerticalAlignment="Center" Text="Anonymised case study" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <controls:BusyCaption
                            IsActive="{x:Bind ViewModel.SummaryPending, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.SummaryPending, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="Rewrite"
                            Command="{x:Bind ViewModel.RewriteSummaryCommand}"
                            Style="{StaticResource TrayButton}"
                            ToolTipService.ToolTip="Write the case study again from the clinical note">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="{StaticResource CaptionTextBlockFontSize}" Glyph="&#xE72C;" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="Rewrite" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBox
                    AcceptsReturn="True"
                    AutomationProperties.Name="Case study"
                    BorderThickness="0"
                    Background="Transparent"
                    LostFocus="OnSummaryCommitted"
                    PlaceholderText="{x:Bind ViewModel.SummaryPlaceholder, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Summary, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind ViewModel.SummaryProblem, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasSummaryProblem, Mode=OneWay}" />
                <TextBlock
                    Style="{StaticResource CaptionText}"
                    Foreground="{ThemeResource CautionBrush}"
                    TextWrapping="Wrap"
                    Text="{x:Bind ViewModel.Warning, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasWarning, Mode=OneWay}" />
            </StackPanel>
        </Border>

        <StackPanel Spacing="8">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Guidance referred to" />
            <TextBlock
                Style="{StaticResource CaptionText}"
                Text="Found for this consultation"
                Visibility="{x:Bind ViewModel.HasReferences, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.References}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="appraisal:ReflectionReferenceRow">
                        <CheckBox
                            MinWidth="0"
                            AutomationProperties.Name="{x:Bind Name}"
                            IsChecked="{x:Bind Ticked, Mode=TwoWay}">
                            <StackPanel Spacing="2">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{x:Bind Reference}" />
                                    <Run Text="{x:Bind Title}" />
                                </TextBlock>
                                <TextBlock
                                    Style="{StaticResource CaptionText}"
                                    Text="{x:Bind Source}"
                                    Visibility="{x:Bind SourceVisible}" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource CaptionText}"
                Text="Added by you"
                Visibility="{x:Bind ViewModel.HasAdded, Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Added}" Visibility="{x:Bind ViewModel.HasAdded, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="appraisal:AddedGuidanceRow">
                        <Grid ColumnSpacing="8" Padding="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Title}" TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Remove this guidance"
                                Command="{x:Bind RemoveCommand}"
                                Style="{StaticResource TrayButton}"
                                ToolTipService.ToolTip="Remove">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox
                AutomationProperties.Name="Add guidance"
                KeyDown="OnDraftKeyDown"
                LostFocus="OnDraftLeft"
                PlaceholderText="Add guidance"
                Text="{x:Bind ViewModel.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!-- Only the clinician writes these three answers. Nothing here is generated -->
        <StackPanel Spacing="8">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="What stood out?" />
            <TextBox
                MinHeight="64"
                AcceptsReturn="True"
                AutomationProperties.Name="What stood out"
                LostFocus="OnAnswerCommitted"
                PlaceholderText="What was difficult, went well or surprised you"
                Text="{x:Bind ViewModel.Happened, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="What did I learn?" />
            <TextBox
                MinHeight="64"
                AcceptsReturn="True"
                AutomationProperties.Name="What did I learn"
                LostFocus="OnAnswerCommitted"
                PlaceholderText="What this case taught you, or confirmed"
                Text="{x:Bind ViewModel.Learned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Would I do anything differently?" />
            <TextBox
                MinHeight="64"
                AcceptsReturn="True"
                AutomationProperties.Name="Would I do anything differently"
                LostFocus="OnAnswerCommitted"
                PlaceholderText="What you would change next time, or why you would keep the same approach"
                Text="{x:Bind ViewModel.Next, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid>
            <HyperlinkButton
                Padding="0"
                VerticalAlignment="Center"
                Command="{x:Bind RemoveCommand}"
                Content="Remove from appraisals"
                Style="{StaticResource CaptionLink}"
                Visibility="{x:Bind HasRemove}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.Name="Copy" Command="{x:Bind ViewModel.CopyCommand}" ToolTipService.ToolTip="Copy this reflection as text">
                    <controls:IconLabel IconSize="{StaticResource CaptionTextBlockFontSize}" Glyph="&#xE8C8;" Text="Copy" />
                </Button>
                <Button AutomationProperties.Name="Save as text" Command="{x:Bind ViewModel.SaveAsTextCommand}" ToolTipService.ToolTip="Save this reflection as a text file">
                    <controls:IconLabel IconSize="{StaticResource CaptionTextBlockFontSize}" Glyph="&#xE74E;" Text="Save as text" />
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
