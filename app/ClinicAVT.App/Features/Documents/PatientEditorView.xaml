<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Documents.PatientEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    xmlns:local="using:ClinicAVT.App.Features.Documents">

    <Grid x:Name="Editor" Padding="0,10,0,8" RowSpacing="10">
        <!-- The sheet sizes to its text up to a cap set in code. The actions sit under the
             translation because Copy and Export take the sheet and translation together -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Opened in code when a translation exists -->
            <RowDefinition x:Name="TranslationRow" Height="0" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderRow" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <controls:BusyCaption
                    IsActive="{x:Bind ViewModel.PatientPreparing, Mode=OneWay}"
                    Text="{x:Bind ViewModel.PatientStateCaption, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.PatientCaptionVisible, Mode=OneWay}" />
                <controls:StaleNotice
                    ActionText="Regenerate from note"
                    Command="{x:Bind ViewModel.RegeneratePatientCommand}"
                    Text="This patient information was written before your note edits."
                    Visibility="{x:Bind ViewModel.PatientStale, Mode=OneWay}" />
            </StackPanel>
            <!-- Only the sheet is translated. The note is the clinical
                 record and stays in English -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.Name="Language"
                    IsEnabled="{x:Bind ViewModel.PatientDocumentReady, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                    PlaceholderText="Language"
                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                <Button
                    Command="{x:Bind ViewModel.TranslateCommand}"
                    Content="Translate" />
                <controls:BusyCaption
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.TranslationRunning, Mode=OneWay}"
                    Text="Translating"
                    Visibility="{x:Bind ViewModel.TranslationRunning, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- The host carries the cap for both views -->
        <Grid x:Name="PatientHost" Grid.Row="1" MinHeight="140">
            <controls:DocumentView
                Label="Patient information"
                Text="{x:Bind ViewModel.PatientInfoText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.PatientViewing, Mode=OneWay}" />
            <TextBox
                x:Name="PatientBox"
                AutomationProperties.Name="Patient information"
                Style="{StaticResource DocumentTextBox}"
                Text="{x:Bind ViewModel.PatientInfoText, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.PatientEditing, Mode=OneWay}" />
        </Grid>

        <Grid x:Name="ActionRow" Grid.Row="3" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.Name="Copy" Command="{x:Bind Export.CopyPatientCommand}"
                        IsEnabled="{x:Bind ViewModel.PatientDocumentReady, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PatientCopyTip, Mode=OneWay}">
                    <controls:IconLabel Glyph="&#xE8C8;" Text="Copy" />
                </Button>
                <Button AutomationProperties.Name="Export" Command="{x:Bind Export.ExportPatientCommand}"
                        IsEnabled="{x:Bind ViewModel.PatientDocumentReady, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PatientExportTip, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.PatientViewing, Mode=OneWay}">
                    <controls:IconLabel Glyph="&#xE898;" Text="Export" />
                </Button>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.Name="Edit"
                    Command="{x:Bind ViewModel.EditPatientCommand}"
                    Visibility="{x:Bind ViewModel.PatientViewing, Mode=OneWay}">
                    <controls:IconLabel Glyph="&#xE70F;" Text="Edit" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.DiscardPatientCommand}"
                    Content="Discard"
                    Visibility="{x:Bind ViewModel.PatientEditing, Mode=OneWay}" />
                <Button
                    AutomationProperties.Name="Save"
                    Command="{x:Bind ViewModel.SavePatientCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.PatientEditing, Mode=OneWay}">
                    <controls:IconLabel Glyph="&#xE74E;" Text="Save" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="2"
            RowSpacing="4"
            Visibility="{x:Bind ViewModel.TranslationVisible, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="TranslationHeader">
                <TextBlock
                    Style="{StaticResource CaptionText}"
                    Text="{x:Bind ViewModel.TranslationCaption, Mode=OneWay}" />
                <controls:StaleNotice
                    ActionText="Translate again"
                    Command="{x:Bind ViewModel.TranslateAgainCommand}"
                    Text="The information changed since it was translated."
                    Visibility="{x:Bind ViewModel.TranslationStale, Mode=OneWay}" />
            </StackPanel>
            <!-- Never edited. A changed sheet is translated again instead -->
            <controls:DocumentView
                x:Name="TranslationView"
                Grid.Row="1"
                MinHeight="96"
                FlowDirection="{x:Bind local:PatientEditorView.Flow(ViewModel.TranslationRightToLeft), Mode=OneWay}"
                Label="{x:Bind ViewModel.TranslationCaption, Mode=OneWay}"
                Text="{x:Bind ViewModel.TranslationText, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
