<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Documents.TranscriptPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ClinicAVT.App.Features.Documents"
    xmlns:vm="using:ClinicAVT.App.Core.Features.Documents">

    <Grid>
        <!-- The item container is the card, so the platform hover and theme behaviour still apply -->
        <ListView
            x:Name="TurnList"
            Margin="0,8,0,0"
            ItemsSource="{x:Bind ViewModel.Turns}"
            Padding="0,0,0,8"
            SelectionMode="None">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TranscriptTurnItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle
                            RadiusX="1.5"
                            RadiusY="1.5"
                            Style="{x:Bind views:SpeakerPalette.Stripe(Speaker)}" />
                        <StackPanel Grid.Column="1" Margin="13,10,0,10">
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{x:Bind views:SpeakerPalette.Name(Speaker)}"
                                Text="{x:Bind SpeakerLabel}" />
                            <TextBlock
                                Margin="0,1,0,0"
                                Style="{StaticResource MicroText}"
                                Text="{x:Bind TimeLabel}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            Margin="0,10,14,10"
                            Style="{StaticResource BodyText}"
                            Text="{x:Bind Text}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
