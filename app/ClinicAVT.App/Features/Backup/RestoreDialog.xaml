<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="ClinicAVT.App.Features.Backup.RestoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    Title="Restore from a backup"
    CloseButtonText="{x:Bind ViewModel.CloseText, Mode=OneWay}"
    DefaultButton="None"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.PrimaryEnabled, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryText, Mode=OneWay}"
    PrimaryButtonClick="OnPrimary"
    Closing="OnClosing">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">620</x:Double>
    </ContentDialog.Resources>

    <!-- Scrolls so a large Windows text size never pushes a control out of reach -->
    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0" Spacing="16">
            <TextBlock
                Text="{x:Bind ViewModel.Caption}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Choosing, Mode=OneWay}" />

            <TextBlock
                Foreground="{ThemeResource CautionBrush}"
                Text="{x:Bind ViewModel.KeepingOffLine}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.KeepingOff}" />

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Choosing, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{x:Bind ViewModel.ChooseFileCommand}" Content="Choose a file" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
                <PasswordBox
                    Header="Password"
                    PasswordChanged="OnPasswordChanged"
                    PasswordRevealMode="Peek" />
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Busy, Mode=OneWay}">
                <ProgressBar Maximum="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.SummaryLine, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.Summarised, Mode=OneWay}" />

            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Style="{ThemeResource BodyStrongTextBlockStyle}"
                Text="{x:Bind ViewModel.DoneLine, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Finished, Mode=OneWay}" />

            <controls:WarningLine Text="{x:Bind ViewModel.Error, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
