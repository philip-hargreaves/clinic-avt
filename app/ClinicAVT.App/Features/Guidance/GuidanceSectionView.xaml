<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Features.Guidance.GuidanceSectionView"
    x:Name="Section"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClinicAVT.App.Controls"
    xmlns:views="using:ClinicAVT.App.Features.Guidance"
    xmlns:vm="using:ClinicAVT.App.Core.Features.Guidance">

    <Grid RowSpacing="8" Visibility="{x:Bind ViewModel.Visible, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- A grid because a text block only trims inside a finite width -->
            <Grid
                VerticalAlignment="Center"
                ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource MicroText}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                <!-- Fades out a few seconds after it appears -->
                <StackPanel
                    x:Name="Timing"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind ViewModel.FoundInVisible, Mode=OneWay}">
                    <TextBlock Style="{StaticResource MicroText}" Text="&#xB7;" />
                    <TextBlock Style="{StaticResource MicroText}" Text="{x:Bind ViewModel.FoundIn, Mode=OneWay}" />
                </StackPanel>
            </Grid>
            <!-- Enter or the glyph searches. Escape clears -->
            <AutoSuggestBox
                Grid.Column="1"
                MinWidth="200"
                AutomationProperties.Name="Search guidance"
                IsEnabled="{x:Bind Search.QueryBoxEnabled, Mode=OneWay}"
                KeyDown="OnQueryKeyDown"
                PlaceholderText="Search guidance"
                QueryIcon="Find"
                QuerySubmitted="OnQuerySubmitted"
                Text="{x:Bind Search.Query, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- A stack panel because a collapsed grid row would keep its spacing -->
            <StackPanel Spacing="6">
                <!-- A typed query replaces the note's cards until Clear -->
                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.QueryShown, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource CaptionText}"
                        Text="{x:Bind ViewModel.QueryHeader, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressRing
                        Grid.Column="1"
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind Search.QuerySearching, Mode=OneWay}"
                        Visibility="{x:Bind Search.QuerySearching, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource MicroText}"
                        Text="{x:Bind Search.QueryCaption, Mode=OneWay}"
                        Visibility="{x:Bind Search.QueryCaptionVisible, Mode=OneWay}" />
                    <HyperlinkButton
                        Grid.Column="3"
                        Command="{x:Bind Search.ClearQueryCommand}"
                        Content="Clear"
                        Style="{StaticResource CaptionLink}" />
                </Grid>
                <!-- A horizontal panel clipped a long caption -->
                <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.CaptionVisible, Mode=OneWay}">
                    <controls:BusyCaption
                        IsActive="{x:Bind ViewModel.Searching, Mode=OneWay}"
                        Text="{x:Bind ViewModel.StateCaption, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Command="{x:Bind Search.SearchNoteCommand}"
                        Content="Search again"
                        Style="{StaticResource CaptionLink}"
                        Visibility="{x:Bind ViewModel.Failed, Mode=OneWay}" />
                    <HyperlinkButton
                        Command="{x:Bind Search.SearchNoteCommand}"
                        Content="Search"
                        Style="{StaticResource CaptionLink}"
                        Visibility="{x:Bind ViewModel.NotSearched, Mode=OneWay}" />
                    <HyperlinkButton
                        Command="{x:Bind Shell.ShowSettingsCommand}"
                        Content="Open Settings"
                        Style="{StaticResource CaptionLink}"
                        Visibility="{x:Bind ViewModel.SettingsLinkVisible, Mode=OneWay}" />
                </StackPanel>
                <!-- The note changed after the search -->
                <controls:StaleNotice
                    ActionText="Search again"
                    Command="{x:Bind Search.SearchNoteCommand}"
                    Text="{x:Bind ViewModel.StaleCaption, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.SearchAgainVisible, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource CautionBrush}"
                    Style="{StaticResource MicroText}"
                    Text="Not saved with this consultation."
                    Visibility="{x:Bind ViewModel.NotStored, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                Visibility="{x:Bind ViewModel.CardsVisible, Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GuidanceCard">
                            <StackPanel>
                                <!-- A hairline with the source's name where the added documents end -->
                                <Grid
                                    Margin="0,2,0,10"
                                    ColumnSpacing="10"
                                    Visibility="{x:Bind DividerVisible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource MicroText}"
                                        Text="{x:Bind Divider}" />
                                    <Rectangle
                                        Grid.Column="2"
                                        Height="1"
                                        VerticalAlignment="Center"
                                        Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                </Grid>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="16,14,16,10"
                                    Style="{StaticResource InnerCardSurface}">
                                    <StackPanel>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{x:Bind Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource MicroText}" Text="{x:Bind Meta}" />
                                            </StackPanel>
                                            <Border
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Style="{x:Bind views:ChipStyles.Border(FromDocument)}">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Style="{x:Bind views:ChipStyles.Text(FromDocument)}"
                                                    Text="{x:Bind Chip}" />
                                            </Border>
                                        </Grid>
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{x:Bind Recommendations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GuidanceRecommendation">
                                                    <Border
                                                        Padding="0,16,0,12"
                                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                        BorderThickness="0,1,0,0"
                                                        PointerEntered="OnRowEntered"
                                                        PointerExited="OnRowExited">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnSpacing="8" Visibility="{x:Bind LabelVisible}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Style="{StaticResource CaptionText}"
                                                                    Text="{x:Bind Number}" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionText}"
                                                                    Text="{x:Bind Tag}"
                                                                    Visibility="{x:Bind TagVisible}" />
                                                                <TextBlock
                                                                    Grid.Column="2"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                    Style="{StaticResource CaptionText}"
                                                                    Text="{x:Bind PageLabel}"
                                                                    Visibility="{x:Bind PageLabelVisible}" />
                                                                <TextBlock
                                                                    Grid.Column="3"
                                                                    Style="{StaticResource MicroText}"
                                                                    Text="{x:Bind Path}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTipService.ToolTip="{x:Bind Path}"
                                                                    Visibility="{x:Bind PathVisible}" />
                                                            </Grid>
                                                            <TextBlock
                                                                IsTextSelectionEnabled="True"
                                                                Style="{StaticResource RecommendationText}"
                                                                Text="{x:Bind Text}" />
                                                            <TextBlock
                                                                Style="{StaticResource MicroText}"
                                                                Text="{x:Bind Matched}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTipService.ToolTip="{x:Bind Matched}"
                                                                Visibility="{x:Bind MatchedVisible}" />
                                                            <!-- The commands use ElementName because x:Bind in a template sees only the item -->
                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                <HyperlinkButton
                                                                    AutomationProperties.Name="{x:Bind ShowName}"
                                                                    Click="OnShowInDocument"
                                                                    Style="{StaticResource CaptionLink}"
                                                                    Visibility="{x:Bind ShowVisible}">
                                                                    <controls:IconLabel Style="{StaticResource LinkIconLabel}" Glyph="&#xE7C3;" Text="Show in document" />
                                                                </HyperlinkButton>
                                                                <HyperlinkButton
                                                                    AutomationProperties.Name="{x:Bind OpenName}"
                                                                    Command="{Binding ElementName=Section, Path=ViewModel.OpenCommand}"
                                                                    CommandParameter="{x:Bind}"
                                                                    Style="{StaticResource CaptionLink}"
                                                                    ToolTipService.ToolTip="{x:Bind views:GuidanceSectionView.Tip(OpenTip)}"
                                                                    Visibility="{x:Bind CanOpen}">
                                                                    <controls:IconLabel Style="{StaticResource LinkIconLabel}" Glyph="&#xE8A7;" Text="Open" />
                                                                </HyperlinkButton>
                                                                <HyperlinkButton
                                                                    AutomationProperties.Name="{x:Bind CopyName}"
                                                                    Command="{Binding ElementName=Section, Path=ViewModel.CopyCitationCommand}"
                                                                    CommandParameter="{x:Bind}"
                                                                    Style="{StaticResource CaptionLink}">
                                                                    <controls:IconLabel Style="{StaticResource LinkIconLabel}" Glyph="&#xE8C8;" Text="Copy citation" />
                                                                </HyperlinkButton>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
