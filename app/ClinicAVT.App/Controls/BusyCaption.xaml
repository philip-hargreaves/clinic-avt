<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Controls.BusyCaption"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">

    <!-- A Grid lets the caption wrap. The gap is the ring's margin, so it collapses with the
         ring -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ProgressRing
            Width="14"
            Height="14"
            Margin="0,0,8,0"
            IsActive="{x:Bind IsActive, Mode=OneWay}"
            Visibility="{x:Bind IsActive, Mode=OneWay}" />
        <TextBlock
            x:Name="Caption"
            Grid.Column="1"
            Style="{StaticResource MicroText}"
            Text="{x:Bind Text, Mode=OneWay}"
            TextWrapping="{x:Bind TextWrapping, Mode=OneWay}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
