<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ClinicAVT.App.Controls.LevelRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Readings arrive ten times a second; the transitions glide between them -->
        <Ellipse x:Name="Glow">
            <Ellipse.ScaleTransition>
                <Vector3Transition Duration="0:0:0.12" />
            </Ellipse.ScaleTransition>
        </Ellipse>
        <Ellipse x:Name="Ring" StrokeThickness="1.5">
            <Ellipse.ScaleTransition>
                <Vector3Transition Duration="0:0:0.12" />
            </Ellipse.ScaleTransition>
        </Ellipse>
    </Grid>
</UserControl>
